{
  "name": "mtilabs-ui-kit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "node scripts/copy-license.mjs && ng build ui",
    "watch": "node scripts/copy-license.mjs && ng build ui --watch --configuration development",
    "test": "ng test ui",
    "lint": "ng lint ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "ng run ui:storybook",
    "storybook:build": "ng run ui:build-storybook",
    "test:storybook": "vitest run --project=storybook --root projects/ui",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "workspaces": [
    "projects/*"
  ],
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@angular-devkit/architect": "^0.2200.0",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.2",
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/angular-vite": "^10.6.0",
    "@types/node": "^20",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.8"
  }
}
